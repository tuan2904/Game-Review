DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev via Docker Compose (docker-compose.yml at project root):
# host PostgreSQL is on 5432; the container maps host 5433 -> container 5432.
# POSTGRES_PASSWORD defaults to "dev_password" in docker-compose.yml;
# set the same value here (or override POSTGRES_PASSWORD when starting Compose).
DB_NAME=gamereview
DB_USER=tuanhd
DB_PASSWORD=dev_password
DB_HOST=127.0.0.1
DB_PORT=5433

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Logging: DEBUG | INFO | WARNING | ERROR
DJANGO_LOG_LEVEL=INFO
