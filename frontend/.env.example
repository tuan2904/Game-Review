# Frontend environment variables (Vite: only VITE_* is exposed to the app).
# Copy to `.env.local` for local overrides — `.env*` files are gitignored.

# Django development server base URL (must end with /api/v1).
# Default applied in code when unset: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
